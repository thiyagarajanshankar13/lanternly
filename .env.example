# Where the deployer keeps its database (SQLite). On the VM: /data
DEPLOYER_DATA_DIR=./data

# 32 random bytes as hex (openssl rand -hex 32). Encrypts the club secrets
# (Square tokens, SMTP password) the deployer stores. Losing it loses them.
DEPLOYER_SECRET_KEY=

# One-time code needed to create the first admin at /admin/setup
# (openssl rand -hex 16). Remove it once the admin exists.
DEPLOYER_SETUP_TOKEN=

# The deployer's own web address (used in links and the two-step sign-in label).
DEPLOYER_URL=http://localhost:3100

# SSH private key the deployer uses to reach clubs VMs (the matching public
# key goes into setup-clubs-vm.sh). Either a file path or the key itself.
DEPLOYER_SSH_KEY_FILE=
DEPLOYER_SSH_KEY=


# Local development without a clubs VM: operations are simulated.
DEPLOYER_FAKE_ENGINE=

